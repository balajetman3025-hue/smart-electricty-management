# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase Configuration (leave blank to use the built-in full-stack SQLite + WebSocket server)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Session Signing Secret (used by server.ts)
SESSION_SECRET="luminacraft-dev-session-secret-change-in-prod"
